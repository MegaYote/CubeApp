<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CubeEditor</AssemblyName>
    <RootNamespace>CubeEditor</RootNamespace>
  </PropertyGroup>

  <!-- AtlasChecker is its own exe with its own csproj; don't glob its sources into this one. -->
  <ItemGroup>
    <Compile Remove="AtlasChecker\**\*" />
    <EmbeddedResource Remove="AtlasChecker\**\*" />
    <None Remove="AtlasChecker\**\*" />
  </ItemGroup>

</Project>
