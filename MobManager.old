using System;
using System.Collections.Generic;
using System.Numerics;
using CubeApp.World;

namespace CubeApp
{
    /// <summary>
    /// Manages duck mob lifecycle: spawning, physics update, and rendering instances.
    /// Extracted from Program.cs so new mob types can be added without modifying the main class.
    /// </summary>
    public sealed class MobManager : IDisposable
    {
        private readonly ChunkManager _manager;
        private readonly List<Duck> _ducks = new();
        private readonly List<DuckInstance> _duckInstances = new();

        // Duck constants from Program.cs
        private const double PlayerHeight = 1.8;
        private const double EyeHeight = 1.62;

        public MobManager(ChunkManager manager) => _manager = manager;

        /// <summary>
        /// Spawns a duck at the current view position, facing toward the player.
        /// </summary>
        public void SpawnDuckAtView(float cameraYaw, Point3D cameraPosition)
        {
            float yawRad = cameraYaw * (float)Math.PI / 180f;
            double fx = Math.Sin(yawRad);
            double fz = Math.Cos(yawRad);

            double spawnX = Math.Floor(cameraPosition.X + fx * 2.0) + 0.5;
            double spawnZ = Math.Floor(cameraPosition.Z + fz * 2.0) + 0.5;
            double feetY = cameraPosition.Y - EyeHeight;
            double spawnY = Math.Floor(feetY) + 3.0;

            double toPlayerX = cameraPosition.X - spawnX;
            double toPlayerZ = cameraPosition.Z - spawnZ;
            float duckYaw = (float)Math.Atan2(-toPlayerX, -toPlayerZ);

            _ducks.Add(new Duck(new Point3D(spawnX, spawnY, spawnZ), duckYaw));
        }

        /// <summary>
        /// Updates all living ducks' physics and removes dead ones.
        /// </summary>
        public void Update(float deltaSeconds)
        {
            for (int i = _ducks.Count - 1; i >= 0; i--)
            {
                var duck = _ducks[i];
                duck.Update(deltaSeconds, _manager);
                if (duck.Removed)
                {
                    _ducks.RemoveAt(i);
                }
            }
        }

        /// <summary>
        /// Checks if any duck is within melee range along the given ray.
        /// If so, damages it and returns true.
        /// </summary>
        public bool TryAttackDuck(Point3D cameraPosition, Point3D forward)
        {
            const float BlockReach = 6.5f;

            var duck = TryPickDuck(cameraPosition, forward, out double duckDistance);
            if (duck == null) return false;

            _ = TryPickBlockForComparison(cameraPosition, forward, out double blockDistance);
            if (duckDistance > blockDistance + 0.02) return false;

            duck.Damage(1, cameraPosition.X, cameraPosition.Z, true);
            return true;
        }

        public IReadOnlyList<DuckInstance> GetInstances()
        {
            _duckInstances.Clear();
            foreach (var duck in _ducks)
            {
                _duckInstances.Add(duck.ToInstance());
            }
            return _duckInstances;
        }

        private Duck? TryPickDuck(Point3D origin, Point3D direction, out double hitDistance)
        {
            hitDistance = double.PositiveInfinity;
            Duck? best = null;
            var dir = direction.Normalized();
            float half = Duck.Width * 0.5f;

            foreach (var duck in _ducks)
            {
                if (duck.IsDead) continue;

                double minX = duck.Position.X - half;
                double maxX = duck.Position.X + half;
                double minY = duck.Position.Y;
                double maxY = duck.Position.Y + Duck.Height;
                double minZ = duck.Position.Z - half;
                double maxZ = duck.Position.Z + half;

                if (RayBox(origin, dir, minX, minY, minZ, maxX, maxY, maxZ, out double t)
                    && t <= BlockReach && t < hitDistance)
                {
                    hitDistance = t;
                    best = duck;
                }
            }

            return best;
        }

        private static bool RayBox(
            Point3D origin, Point3D dir,
            double minX, double minY, double minZ,
            double maxX, double maxY, double maxZ,
            out double tEntry)
        {
            tEntry = 0;
            double tMin = double.NegativeInfinity;
            double tMax = double.PositiveInfinity;

            for (int axis = 0; axis < 3; axis++)
            {
                double o = axis == 0 ? origin.X : (axis == 1 ? origin.Y : origin.Z);
                double d = axis == 0 ? dir.X : (axis == 1 ? dir.Y : origin.Z == 0 && axis != 2 ? dir.Z : dir.Y);
                double lo = axis == 0 ? minX : (axis == 1 ? minY : minZ);
                double hi = axis == 0 ? maxX : (axis == 1 ? maxY : maxZ);

                if (Math.Abs(d) < 1e-9)
                {
                    if (o < lo || o > hi) return false;
                }
                else
                {
                    double t1 = (lo - o) / d;
                    double t2 = (hi - o) / d;
                    if (t1 > t2) (t1, t2) = (t2, t1);
                    if (t1 > tMin) tMin = t1;
                    if (t2 < tMax) tMax = t2;
                    if (tMin > tMax) return false;
                }
            }

            if (tMax < 0) return false;
            tEntry = tMin < 0 ? 0 : tMin;
            return true;
        }

        /// <summary>
        /// Stub: returns a block-distance larger than reach to let duck-priority win.
        /// Replace with a real TryPickBlock call from BlockInteractionSystem when wired up.
        /// </summary>
        private static bool TryPickBlockForComparison(Point3D origin, Point3D direction, out double hitDistance)
        {
            hitDistance = 999.0; // Duck wins by default until wired to real system
            return false;
        }

        public void Dispose() { }
    }
}
