<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Produce a single, self-contained .exe (runtime + native libs baked in). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Copy content files to output for runtime loading -->
    <CopyOutputDirectoryItemsToPublishDirectoryStyle>PreserveNewest</CopyOutputDirectoryItemsToPublishDirectoryStyle>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bake the texture atlas into the assembly so no loose files need to ship. -->
    <EmbeddedResource Include="terrain.png" />
    <!-- Bake the duck test-mob texture in as well. -->
    <EmbeddedResource Include="duck.png" />
    <!-- Player skin for the Minecraft-style player model. -->
    <EmbeddedResource Include="player.png" />
    <!-- Data-driven block definitions (texture tiles, flags, hotbar, map colours). -->
    <EmbeddedResource Include="blocks.json" />
    <!-- Title-screen logo graphic. -->
    <EmbeddedResource Include="cubuild.png" />
    <!-- Hotbar frame (169x16, 10 slots) + selected-slot highlight (18x18), from Cubuild.html. -->
    <EmbeddedResource Include="hotbar.png" />
    <EmbeddedResource Include="hotbar_select.png" />
    <!-- Infdev-style sun/moon sprites for the celestial sky quads. -->
    <EmbeddedResource Include="sun.png" />
    <EmbeddedResource Include="moon.png" />
    <!-- Game sound effects (decoded to PCM once at startup, played from memory). -->
    <EmbeddedResource Include="sounds\grass.mp3" />
    <EmbeddedResource Include="sounds\cavesound1.mp3" />
    <EmbeddedResource Include="sounds\cavesound2.mp3" />
    <EmbeddedResource Include="sounds\cavesound3.mp3" />
    <EmbeddedResource Include="sounds\cavesound4.mp3" />
    <EmbeddedResource Include="sounds\cavesound5.mp3" />
    <EmbeddedResource Include="sounds\cavesound6.mp3" />
    <EmbeddedResource Include="sounds\cavesound7.mp3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copy GLB models to output -->
    <None Include="MobEntities\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
    <PackageReference Include="Veldrid.ImGui" Version="5.89.2-ga121087cad" />
    <PackageReference Include="Veldrid.SDL2" Version="4.9.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="SharpGLTF" Version="1.0.0-alpha0001" />
  </ItemGroup>
</Project>