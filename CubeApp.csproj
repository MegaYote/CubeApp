<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- OpenAL (Silk.NET) uses pointer-based calls for device/source handles. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Self-contained with all DLLs and native libraries -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Include native libraries -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Copy content files to output for runtime loading -->
    <CopyOutputDirectoryItemsToPublishDirectoryStyle>PreserveNewest</CopyOutputDirectoryItemsToPublishDirectoryStyle>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bake the texture atlas into the assembly so no loose files need to ship. -->
    <EmbeddedResource Include="Assets\Textures\terrain.png" />
    <!-- Items atlas (flint drop icon, etc). -->
    <EmbeddedResource Include="Assets\Textures\items.png" />
    <!-- Bake the duck test-mob texture in as well. -->
    <EmbeddedResource Include="Assets\Textures\duck.png" />
    <!-- Player skin for the Minecraft-style player model. -->
    <EmbeddedResource Include="Assets\Textures\player.png" />
    <!-- Data-driven block definitions (texture tiles, flags, hotbar, map colours). -->
    <EmbeddedResource Include="Assets\Data\blocks.json" />
    <!-- Data-driven item definitions (tools, food, gemstones; items.png atlas tiles). -->
    <EmbeddedResource Include="Assets\Data\items.json" />
    <!-- Data-driven biome definitions (temperature/humidity ranges, height, surfaces). -->
    <EmbeddedResource Include="Assets\Data\biomes.json" />
    <!-- Data-driven 2x2 crafting recipes (grid input -> item output). -->
    <EmbeddedResource Include="Assets\Data\recipes.json" />
    <!-- Workbench crafting menu background (user's UI design). -->
    <EmbeddedResource Include="Assets\Textures\crafting.png" />
    <!-- Title-screen logo graphic. -->
    <EmbeddedResource Include="Assets\Textures\cubuild.png" />
    <!-- Healthbar sprite sheet (10 slice-countdown hearts + extras; top-left = full heart). -->
    <EmbeddedResource Include="Assets\Textures\healthbar.png" />
    <!-- Hotbar frame (169x16, 10 slots) + selected-slot highlight (18x18), from Cubuild.html. -->
    <EmbeddedResource Include="Assets\Textures\hotbar.png" />
    <EmbeddedResource Include="Assets\Textures\inventory.png" />
    <EmbeddedResource Include="Assets\Textures\hotbar_select.png" />
    <!-- Infdev-style sun/moon sprites for the celestial sky quads. -->
    <EmbeddedResource Include="Assets\Textures\sun.png" />
    <EmbeddedResource Include="Assets\Textures\moon.png" />
    <!-- Game sound effects (decoded to PCM once at startup, played from memory). -->
    <EmbeddedResource Include="Assets\Sounds\grass.mp3" />
    <EmbeddedResource Include="Assets\Sounds\cavesound1.mp3" />
    <EmbeddedResource Include="Assets\Sounds\cavesound2.mp3" />
    <EmbeddedResource Include="Assets\Sounds\cavesound3.mp3" />
    <EmbeddedResource Include="Assets\Sounds\cavesound4.mp3" />
    <EmbeddedResource Include="Assets\Sounds\cavesound5.mp3" />
    <EmbeddedResource Include="Assets\Sounds\cavesound6.mp3" />
    <EmbeddedResource Include="Assets\Sounds\cavesound7.mp3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copy GLB models to output -->
    <None Include="MobEntities\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.21.0" />
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.StartupUtilities" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
    <PackageReference Include="Veldrid.ImGui" Version="5.89.2-ga121087cad" />
    <PackageReference Include="Veldrid.SDL2" Version="4.9.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="SharpGLTF" Version="1.0.0-alpha0001" />
  </ItemGroup>
</Project>

