{
  // ============================================================================
  // biomes.json — terrain biome definitions.
  //
  // Every world column gets exactly one biome, chosen by matching its noise
  // temperature and humidity against the ranges below (first match wins in
  // file order). Tune the ranges to reshape the world's layout.
  //
  // FIELDS:
  //   id              unique lowercase id (used in code/debug)
  //   displayName     name shown in debug/UI
  //   temperature     { "min": -1..1, "max": -1..1 } matching range for noise temp
  //   humidity        { "min": -1..1, "max": -1..1 } matching range for noise humidity
  //   water           true = generate as ocean (terrain sits below water level)
  //   baseHeight      0..1 ground elevation baseline (higher = higher ground)
  //   heightVariation 0..1 how much the surface rolls up and down
  //   amplified       true = relief swings BOTH ways (real peaks AND deep valleys,
  //                   amplified-worlds style) instead of only carving downward
  //   surfaceBlock    block id for the top layer
  //   fillBlock       block id for the layers below the surface
  //   fillDepth       how many layers of fillBlock under the surface block
  //   treeDensity     0..n trees per chunk attempt rate (0 = no trees)
  //   treeType        "oak" | "pine" (which tree style to spawn)
  //   fillMixBlock    optional second fill block scattered through the fill
  //   fillMixChance   0..1 chance a fill layer is fillMixBlock instead
  //
  // DEFAULTS when omitted: baseHeight 0.4, heightVariation 0.1, surfaceBlock
  // "grass", fillBlock "dirt", fillDepth 3, treeDensity 0, treeType "oak".
  // ============================================================================

  "biomes": [
    // ---- CLASSIC: minecraft-classic terrain style. The surface line is a pure 2D heightmap
    // (classic had no rolling 3D hills!), QUANTIZED into blocky steps - flat plateaus that
    // suddenly cliff up to the next level. Sheer coasts, blocky tablelands, zero smoothness.
    {
      "id": "classic",
      "displayName": "Classic",
      "temperature": { "min": 0.65, "max": 0.95 },
      "humidity": { "min": 0.0, "max": 0.45 },
      "water": false,
      "baseHeight": 0.8,
      "heightVariation": 0.0,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 1
    },
    // ---- ANOMALY (experimental): the density field is 4D simplex noise sampled on a
    // curved slice through 4D space (w follows y with a slow sine fold), so the terrain
    // folds and weaves with twisted strata - structures impossible for 3D noise. Claims
    // a small climate sliver; listed FIRST so first-match-wins gives it the band.
    {
      "id": "anomaly",
      "displayName": "Anomaly",
      "temperature": { "min": 0.40, "max": 0.60 },
      "humidity": { "min": -0.60, "max": 0.10 },
      "water": false,
      "baseHeight": 0.85,
      "heightVariation": 0.5,
      "amplified": true,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 0
    },
    // ---- ALPHA: a byte-faithful port of Minecraft's "old terrain generator" - the exact
    // generator Alpha v1.1.2_01 shipped with (the last release to use it). Full 684.412
    // density field, the alpha surface pass (grass band at 60-65, sand/gravel dice, noise
    // dirt depth), big trees from mobSpawnerNoise, and the alpha ore distribution. The
    // optional "alpha" object exposes the generator knobs; these defaults are the exact
    // 2010 constants. Claims the warm damp band between anomaly and paradise.
    {
      "id": "alpha",
      "displayName": "Alpha",
      "temperature": { "min": 0.40, "max": 0.65 },
      "humidity": { "min": 0.10, "max": 0.60 },
      "water": false,
      "baseHeight": 0.5,
      "heightVariation": 0.25,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 0,
      "alpha": {
        "lowNoiseOctaves": 16,
        "highNoiseOctaves": 16,
        "selectorNoiseOctaves": 8,
        "sandGravelNoiseOctaves": 4,
        "dirtDepthNoiseOctaves": 4,
        "treeNoiseOctaves": 5,
        "coordinateScale": 684.412,
        "heightScale": 984.412,
        "mainNoiseScaleXZ": 8.55515,
        "mainNoiseScaleY": 1.71103,
        "heightStretch": 4.0
      }
    },
    {
      "id": "paradise",
      "displayName": "Paradise Foothills",
      "temperature": { "min": 0.30, "max": 0.50 },
      "humidity": { "min": -0.35, "max": 0.15 },
      "water": false,
      "baseHeight": 0.80,
      "heightVariation": 0.18,
      "surfaceBlock": "redclay",
      "fillBlock": "redclay",
      "fillDepth": 5,
      "treeDensity": 2,
      "treeType": "pine",
      "fillMixBlock": "dirt",
      "fillMixChance": 0.5
    },
    {
      "id": "desert",
      "displayName": "Desert",
      "temperature": { "min": 0.0, "max": 1.0 },
      "humidity": { "min": -1.0, "max": -0.15 },
      "water": false,
      "baseHeight": 0.55,
      "heightVariation": 0.13,
      "surfaceBlock": "sand",
      "fillBlock": "sand",
      "fillDepth": 6,
      "treeDensity": 0
    },
    // ---- amplified hills: plains' climate band split in half, so hills and plains
    // appear equally often (first match wins, so hills sits BEFORE plains). Alpha-style
    // drama: highland base with amplified swings (gain 1.2) - valley floors plunge
    // ~50 blocks BELOW sea level into flooded chasms, peaks push past world 150, and a
    // heavy block-level 3D carve roughens every surface with overhangs and arches.
    {
      "id": "hills",
      "displayName": "Hills",
      "temperature": { "min": 0.0, "max": 1.0 },
      "humidity": { "min": -0.15, "max": 0.425 },
      "water": false,
      "baseHeight": 0.93,
      "heightVariation": 0.75,
      "amplified": true,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 1
    },
    {
      "id": "plains",
      "displayName": "Plains",
      "temperature": { "min": 0.0, "max": 1.0 },
      "humidity": { "min": 0.425, "max": 1.0 },
      "water": false,
      "baseHeight": 0.56,
      "heightVariation": 0.08,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 1
    },
    {
      "id": "mountains",
      "displayName": "Mountains",
      "temperature": { "min": -1.0, "max": -0.8 },
      "humidity": { "min": -1.0, "max": 1.0 },
      "water": false,
      "baseHeight": 0.85,
      "heightVariation": 0.22,
      "surfaceBlock": "stone",
      "fillBlock": "stone",
      "fillDepth": 0,
      "treeDensity": 0
    },
    {
      "id": "ocean",
      "displayName": "Ocean",
      "temperature": { "min": -0.4, "max": 0.0 },
      "humidity": { "min": -1.0, "max": 1.0 },
      "water": true,
      "baseHeight": 0.28,
      "heightVariation": 0.05,
      "surfaceBlock": "sand",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 0
    }
  ]
}