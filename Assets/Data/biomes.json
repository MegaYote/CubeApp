{
  // ============================================================================
  // biomes.json — terrain biome definitions.
  //
  // Every world column gets exactly one biome. Ocean/land is selected independently by
  // continentalness; land biomes use the temperature/humidity ranges below (first match wins).
  // This follows the broad legacy Java balance: about one-third ocean, with climate zones on land.
  //
  // FIELDS:
  //   id              unique lowercase id (used in code/debug)
  //   displayName     name shown in debug/UI
  //   temperature     { "min": -1..1, "max": -1..1 } matching range for noise temp
  //   humidity        { "min": -1..1, "max": -1..1 } matching range for noise humidity
  //   water           true = generate as ocean (terrain sits below water level)
  //   baseHeight      0..1 ground elevation baseline (higher = higher ground)
  //   heightVariation 0..1 how much the surface rolls up and down
  //   amplified       true = relief swings BOTH ways (real peaks AND deep valleys,
  //                   amplified-worlds style) instead of only carving downward
  //   surfaceBlock    block id for the top layer
  //   fillBlock       block id for the layers below the surface
  //   fillDepth       how many layers of fillBlock under the surface block
  //   treeDensity     0..n trees per chunk attempt rate (0 = no trees)
  //   treeType        "oak" | "pine" | "round" | "tall" | "dead" | "willow"
  //                   (which tree style to spawn)
  //   fillMixBlock    optional second fill block scattered through the fill
  //   fillMixChance   0..1 chance a fill layer is fillMixBlock instead
  //
  // DEFAULTS when omitted: baseHeight 0.4, heightVariation 0.1, surfaceBlock
  // "grass", fillBlock "dirt", fillDepth 3, treeDensity 0, treeType "oak".
  // ============================================================================

  // ORDER: first-match-wins. Ocean is selected by a separate continentalness layer. Land
  // temperatures/humidity then select climate biomes; leftover climate edges are smoothly blended.
  //
  // HUMIDITY PARTITION (warm temps; first-match overlaps matter):
  //   paradise    -0.30  to  0.10  (warm moderate; listed before alpha)
  //   alpha       -0.375 to  0.10  (common temperate/forest analogue)
  //   desert      -1.00  to -0.30  (dry end; alpha takes a narrow overlap)
  //   hills        0.45  to  0.539 (narrow ridge)
  //   lowlands     0.10  to  0.85  (plains analogue; hills claims its overlap first)
  //   plains       0.85  to  1.00  (far-humid sliver)
  // ===========================================================================

  "biomes": [
    // ---- POCKET: faithful-ish port of Minecraft Pocket Edition's very first terrain
    // generator (pre-0.9.0): flat grassland with gentle rolling hills, sand beaches,
    // simple oak trees, no overhangs. A nostalgic, simple landscape.
    {
      "id": "pocket",
      "displayName": "Pocket",
      "temperature": { "min": 0.4, "max": 0.8 },
      "humidity": { "min": 0.4, "max": 0.8 },
      "water": false,
      "baseHeight": 0.5,
      "heightVariation": 0.03,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 1,
      "treeType": "oak"
    },
    // ---- CHAOS: extremely rare pocket of absolutely chaotic terrain. Wild overhangs,
    // floating shards, deep chasms and spires. Tiny climate sliver so it stays rare.
    {
      "id": "chaos",
      "displayName": "Chaos",
      "temperature": { "min": 0.92, "max": 0.96 },
      "humidity": { "min": 0.92, "max": 0.96 },
      "water": false,
      "baseHeight": 0.9,
      "heightVariation": 0.9,
      "amplified": true,
      "surfaceBlock": "stone",
      "fillBlock": "stone",
      "fillDepth": 0,
      "treeDensity": 0
    },
    // ---- ANOMALY: extremely rare pocket. Macro climate bias shifts effective ranges by
    // ±0.55 so the raw bands must be tiny. Listed first so it claims its sliver.
    {
      "id": "anomaly",
      "displayName": "Anomaly",
      "temperature": { "min": 0.48, "max": 0.52 },
      "humidity": { "min": -0.21, "max": -0.19 },
      "water": false,
      "baseHeight": 0.85,
      "heightVariation": 0.5,
      "amplified": true,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 8,
      "treeType": "tall"
    },
    // ---- CLASSIC: rare blocky-plateau pocket inside alpha's humidity band. Listed early
    // so it claims a small slice at hot temps.
    {
      "id": "classic",
      "displayName": "Classic",
      "temperature": { "min": 0.65, "max": 0.95 },
      "humidity": { "min": 0.45, "max": 0.50 },
      "water": false,
      "baseHeight": 0.8,
      "heightVariation": 0.0,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 1,
      "treeType": "round"
    },
    // ---- PARADISE: warm + moderate humidity. Red-clay surface, pine trees, foothills.
    // Solid share of the warm band, just below alpha and plains in commonness.
    {
      "id": "paradise",
      "displayName": "Paradise Foothills",
      "temperature": { "min": 0.20, "max": 0.60 },
      "humidity": { "min": -0.30, "max": 0.10 },
      "water": false,
      "baseHeight": 0.80,
      "heightVariation": 0.18,
      "surfaceBlock": "redclay",
      "fillBlock": "redclay",
      "fillDepth": 5,
      "treeDensity": 2,
      "treeType": "pine",
      "fillMixBlock": "dirt",
      "fillMixChance": 0.5
    },
  // ---- BIGLANDS: rare pocket of doubled-height alpha terrain (tall alpha forests).
  {
      "id": "biglands",
      "displayName": "Biglands",
      "temperature": { "min": 0.0, "max": 0.3 },
      "humidity": { "min": 0.0, "max": 0.3 },
      "water": false,
      "baseHeight": 0.5,
      "heightVariation": 0.25,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 2,
      "treeType": "round",
      "alpha": {
        "lowNoiseOctaves": 16,
        "highNoiseOctaves": 16,
        "selectorNoiseOctaves": 8,
        "sandGravelNoiseOctaves": 4,
        "dirtDepthNoiseOctaves": 4,
        "treeNoiseOctaves": 5,
        "coordinateScale": 684.412,
        "heightScale": 984.412,
        "mainNoiseScaleXZ": 8.55515,
        "mainNoiseScaleY": 1.71103,
        "heightStretch": 2.0
      }
  },
  // ---- ALPHA: common forest/temperate analogue, including a little cool climate.
  // Byte-faithful port of Alpha v1.1.2_01 terrain generator.
  // Paradise is listed first and still claims its warm/moderate overlap.
    {
      "id": "alpha",
      "displayName": "Alpha",
      "temperature": { "min": -0.6, "max": 1.0 },
      "humidity": { "min": -0.375, "max": 0.1 },
      "water": false,
      "baseHeight": 0.5,
      "heightVariation": 0.25,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 2,
      "treeType": "round",
      "alpha": {
        "lowNoiseOctaves": 16,
        "highNoiseOctaves": 16,
        "selectorNoiseOctaves": 8,
        "sandGravelNoiseOctaves": 4,
        "dirtDepthNoiseOctaves": 4,
        "treeNoiseOctaves": 5,
        "coordinateScale": 684.412,
        "heightScale": 984.412,
        "mainNoiseScaleXZ": 8.55515,
        "mainNoiseScaleY": 1.71103,
        "heightStretch": 4.0
      }
    },
    // ---- HILLS: narrow amplified-terrain ridge between alpha and plains. Small patches
    // with dramatic overhangs, arches, and deep flooded chasms.
    {
      "id": "hills",
      "displayName": "Hills",
      "temperature": { "min": -0.2, "max": 1.0 },
      "humidity": { "min": 0.45, "max": 0.539 },
      "water": false,
      "baseHeight": 0.93,
      "heightVariation": 0.75,
      "amplified": true,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 1
    },
    // ---- LOWLANDS: plains' bigger sibling - same flat grass country, ~2 blocks
    // lower, oak trees instead of willows. It occupies the humid warmer-land band; plains
    // remains the far-humid sliver.
    // baseHeight: 1 unit = 128 blocks, so 0.545 vs plains' 0.56 = ~1.9 blocks lower.
    {
      "id": "lowlands",
      "displayName": "Lowlands",
      "temperature": { "min": -0.6, "max": 1.0 },
      "humidity": { "min": 0.1, "max": 0.85 },
      "water": false,
      "baseHeight": 0.545,
      "heightVariation": 0.08,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 1,
      "treeType": "oak"
    },
    // ---- PLAINS: flat willow lowlands at the far humid end. Narrower band since lowlands
    // (its oak twin) claims the wider 0.539-0.85 slice.
    {
      "id": "plains",
      "displayName": "Plains",
      "temperature": { "min": -0.6, "max": 1.0 },
      "humidity": { "min": 0.85, "max": 1.0 },
      "water": false,
      "baseHeight": 0.56,
      "heightVariation": 0.08,
      "surfaceBlock": "grass",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 1,
      "treeType": "willow"
    },
    // ---- DESERT: dry end of the spectrum. Sand dunes, no trees. Common in dry macro
    // regions but rare in wet ones (noise bell-curve centers near hum 0).
    {
      "id": "desert",
      "displayName": "Desert",
      "temperature": { "min": -0.6, "max": 1.0 },
      "humidity": { "min": -1.0, "max": -0.30 },
      "water": false,
      "baseHeight": 0.55,
      "heightVariation": 0.13,
      "surfaceBlock": "sand",
      "fillBlock": "sand",
      "fillDepth": 6,
      "treeDensity": 0
    },
    // ---- COLD BIOMES: ocean and mountains fill the cold end of the temperature spectrum.
    // Ocean coverage comes from the independent continentalness layer, not this climate rectangle.
    {
      "id": "ocean",
      "displayName": "Ocean",
      "temperature": { "min": -0.4, "max": -0.1 },
      "humidity": { "min": -1.0, "max": 1.0 },
      "water": true,
      "baseHeight": 0.28,
      "heightVariation": 0.05,
      "surfaceBlock": "sand",
      "fillBlock": "dirt",
      "fillDepth": 3,
      "treeDensity": 0
    },
    {
      "id": "mountains",
      "displayName": "Mountains",
      "temperature": { "min": -1.0, "max": -0.6 },
      "humidity": { "min": -1.0, "max": 1.0 },
      "water": false,
      "baseHeight": 0.9,
      "heightVariation": 0.45,
      "amplified": true,
      "surfaceBlock": "stone",
      "fillBlock": "stone",
      "fillDepth": 0,
      "treeDensity": 0
    }
  ]
}
