{
  // ============================================================================
  // items.json â€” genuine items (tools, food, gemstones...).
  //
  // Every BLOCK is automatically also an item (same id, terrain atlas icon,
  // places itself, 64 stack). This file only needs entries for things that are
  // NOT blocks. Items share one numeric id space with blocks: block items use
  // 0..(block count-1), genuine items are appended after.
  //
  // FIELDS (all optional except "id" and "itemTile"):
  //   id            unique lowercase id
  //   displayName   name shown in menus (defaults to id)
  //   category      "tool" | "food" | "misc" | "gemstone" (groups the E menu)
  //   itemTile      "col,row" tile from items.png (REQUIRED for new items)
  //   stackSize     max per stack (64 typical; tools = 1)
  //   placedBlock   block id this item places when used (default: none)
  //   toolType      "pickaxe" | "axe" | "shovel" â€” mines matching blocks faster
  //   toolLevel     1..3 mining tier
  //   durability    uses before the tool breaks (tools only)
  //   foodValue     hunger restored when eaten (food only)
  //   mapColor      "#RRGGBB" menu/swatch color
  //
  // REDEFINING A BLOCK ITEM: an entry whose "id" matches a BLOCK id overrides
  // that block's item (icon/name/category) in place â€” it keeps its numeric id
  // and still places the block. Example: "sap" below swaps the sap block's
  // terrain icon for a dedicated items.png tile. The "itemTile" field is
  // REQUIRED for block redefinitions too.
  // ============================================================================

  "items": [
    { "id": "flint",            "displayName": "Flint",            "category": "gemstone", "itemTile": "11,2", "stackSize": 64, "mapColor": "#6E6E6E" },
    { "id": "stick",            "displayName": "Stick",            "category": "misc",     "itemTile": "0,0",  "stackSize": 64, "mapColor": "#8A5A2B" },
    { "id": "flint_hatchet",    "displayName": "Flint Hatchet",   "category": "tool",     "itemTile": "1,0",  "stackSize": 1,  "toolType": "axe",     "toolLevel": 2, "durability": 60, "mapColor": "#8A8A8A" },
    { "id": "flint_pickaxe",    "displayName": "Flint Pick",   "category": "tool",     "itemTile": "2,0",  "stackSize": 1,  "toolType": "pickaxe",  "toolLevel": 2, "durability": 60, "mapColor": "#8A8A8A" },
    { "id": "flint_shovel",     "displayName": "Flint Shovel",     "category": "tool",     "itemTile": "3,0",  "stackSize": 1,  "toolType": "shovel",   "toolLevel": 2, "durability": 60, "mapColor": "#8A8A8A" },
    { "id": "flint_spear",      "displayName": "Flint Spear",      "category": "tool",     "itemTile": "4,0",  "stackSize": 1,  "durability": 80, "mapColor": "#8A8A8A" },
    { "id": "persimmon",        "displayName": "Persimmon",        "category": "food",     "itemTile": "0,2",  "stackSize": 64, "foodValue": 4, "mapColor": "#D2691E" },

    // empty bucket â€” tile 1,2 on items.png; fill mechanics later
    { "id": "bucket",           "displayName": "Bucket",           "category": "tool",     "itemTile": "1,2",  "stackSize": 1,  "mapColor": "#7A7A7A" },
    { "id": "water_bucket",   "displayName": "Water Bucket",   "category": "tool",     "itemTile": "3,2",  "stackSize": 1,  "mapColor": "#3A6FD8" },

    { "id": "wood_sealant_bucket", "displayName": "Wood Sealant Bucket", "category": "tool",     "itemTile": "2,2",  "stackSize": 1,  "durability": 8, "mapColor": "#4A3728" },

    // "sap" is a BLOCK (see blocks.json); this entry only gives its dropped
    // item a dedicated icon from items.png. placedBlock "" clears the block's
    // placement: sap blocks are only obtainable by crafting (later) - for now the
    // dropped/held item is just an ingredient that can't be placed.
    { "id": "sap",              "displayName": "Sap",              "category": "misc",     "itemTile": "10,2", "stackSize": 64, "placedBlock": "", "mapColor": "#442200" },

    // ----- fuel & materials (items.png row 2, cols 12-15) ------------------------------
    // Minecart: right-click a rail to set it down, right-click the cart to board it.
    { "id": "cart", "displayName": "Minecart", "category": "tool", "itemTile": "1,3", "stackSize": 1, "mapColor": "#8A5A2B" },
    { "id": "quartz_shard",     "displayName": "Quartz Shard",     "category": "gemstone", "itemTile": "12,2", "stackSize": 64, "mapColor": "#F1EBE2" },
    { "id": "charcoal",         "displayName": "Charcoal",         "category": "misc",     "itemTile": "13,2", "stackSize": 64, "mapColor": "#2B2B2B" },
    { "id": "charcoal_fragment","displayName": "Charcoal Fragment","category": "misc",     "itemTile": "14,2", "stackSize": 64, "mapColor": "#3A3A3A" },
    { "id": "coal",             "displayName": "Coal",             "category": "misc",     "itemTile": "15,2", "stackSize": 64, "mapColor": "#1C1C1C" },

    // ----- vehicles --------------------------------------------------------------------
    // Added at the END on purpose: genuine items take their numeric id from their position in
    // this list, so inserting one above would renumber every item after it and corrupt the
    // hotbar/inventory of any saved world that already holds those items.
    // Boat: right-click water to set one afloat, right-click the boat to board it. Like the
    // minecart it is a placed entity, and its menu icon is the real boat model, not this tile.
    { "id": "boat", "displayName": "Boat", "category": "tool", "itemTile": "1,4", "stackSize": 1, "mapColor": "#96602F" },

    // Ore cart: like the minecart, right-click a rail to set it down - but it has no seat, so
    // you can never ride or drive it. Walk into it to shove it along the track. Its menu icon is
    // the real model (see EntityIconItems), so the tile below is only a fallback.
    { "id": "orecart", "displayName": "Ore Cart", "category": "tool", "itemTile": "1,3", "stackSize": 1, "mapColor": "#5A4030" },

    // Linkage: a coupling part. Appended at the END on purpose (see the vehicles note above) so
    // its numeric id stays stable and no saved inventory shifts. Not placeable and not a tool -
    // just an ingredient for now. Tile 0,3 on items.png.
    { "id": "linkage", "displayName": "Linkage", "category": "misc", "itemTile": "0,3", "stackSize": 64, "mapColor": "#8A8A8A" },

    // Locomotive: a train engine. Appended at the END for the same reason as the linkage above.
    // Right-click a rail to set it down. It has no seat - couple a minecart to it with a linkage,
    // board the CART, and the throttle drives the locomotive, which hauls the whole train. Much
    // faster than a minecart and strong enough to pull a train up a grade. Its menu icon is the
    // real model (see EntityIconItems), so the tile below is only a fallback.
    { "id": "locomotive", "displayName": "Locomotive", "category": "tool", "itemTile": "1,3", "stackSize": 1, "mapColor": "#3A3A3A" }
  ]
}
