{
  // ============================================================================
  // recipes.json — 2x2 crafting recipes for the workbench menu.
  //
  // Each recipe has:
  //   input   the 2x2 grid, row-major: [ top-left, top-right, bottom-left, bottom-right ]
  //           "" or null = empty slot. Any ROTATION of a pattern also matches
  //           (so ["planks","planks","",""] matches it placed vertically too).
  //   output  block or item id to produce
  //   count   how many (default 1)
  //
  // The workbench menu is opened by right-clicking a workbench block. Grid
  // slots hold stacks you drag in from your inventory (E menu cursor); the
  // result appears in the output well and is picked up with a left click.
  // ============================================================================

  "recipes": [
    // four treated planks -> 1 carpenter's workbench
    { "input": ["treated_planks", "treated_planks", "treated_planks", "treated_planks"], "output": "carpenters_workbench", "count": 1 },

    // flint + stick -> 1 flint spear
    { "input": ["flint", "stick", "", ""], "output": "flint_spear", "count": 1 },

    // stick top-left, flint top-right, stick bottom-left, sap bottom-right ->
    // 1 flint hatchet (the sap binds the sticks to the flint, like real life; matches
    // in any rotation)
    { "input": ["stick", "flint", "stick", "sap"], "output": "flint_hatchet", "count": 1 },

    // flint top-left, flint top-right, stick bottom-left, sap bottom-right ->
    // 1 flint pick (the sap binds the flint heads to the stick)
    { "input": ["flint", "flint", "stick", "sap"], "output": "flint_pickaxe", "count": 1 },

    // plank top-left, plank top-right, sap bottom-left, sap bottom-right ->
    // 1 bucket (empty by default)
    { "input": ["planks", "planks", "sap", "sap"], "output": "bucket", "count": 1 },

    // 1 sap + 1 water bucket (any arrangement) -> 1 wood sealant bucket
    { "input": ["sap", "water_bucket", "", ""], "output": "wood_sealant_bucket", "count": 1 },

    // flint top-left, stick bottom-left, sap any position -> 1 flint shovel
    { "input": ["flint", "sap", "stick", ""], "output": "flint_shovel", "count": 1 },

    // sap on top of stick (vertical) -> 1 sap torch (sap makes it sticky for ceiling placement)
    { "input": ["sap", "", "stick", ""], "output": "sap_torch", "count": 1 },

    // two cobblestone -> 4 cobblestone slabs
    { "input": ["cobblestone", "cobblestone", "", ""], "output": "cobblestone_slab", "count": 4 },

    // two sand -> 4 sand slabs
    { "input": ["sand", "sand", "", ""], "output": "sand_slab", "count": 4 },

    // ---- 3x3 recipes (need a crafting table) ----------------------------------
    // Four planks -> workbench
    { "input": ["planks", "planks", "", "planks", "planks", "", "", "", ""], "output": "workbench", "count": 1 },

    // Minecraft's exact tool shapes: 3 material over 2 sticks (pickaxe), 3+2 (axe),
    // 1+2 (shovel), 2+1 (sword stand-in)
    { "input": ["flint", "flint", "flint", "", "stick", "", "", "stick", ""], "output": "flint_pickaxe", "count": 1 },
    { "input": ["flint", "flint", "", "flint", "stick", "", "", "stick", ""], "output": "flint_hatchet", "count": 1 },
    { "input": ["", "flint", "", "", "stick", "", "", "stick", ""], "output": "flint_shovel", "count": 1 },
    { "input": ["", "flint", "", "", "flint", "", "", "stick", ""], "output": "flint_spear", "count": 1 },

    // ---- wood tier ----
    { "input": ["planks", "planks", "planks", "", "stick", "", "", "stick", ""], "output": "wood_pickaxe", "count": 1 },
    { "input": ["planks", "planks", "", "planks", "stick", "", "", "stick", ""], "output": "wood_axe", "count": 1 },
    { "input": ["", "planks", "", "", "stick", "", "", "stick", ""], "output": "wood_shovel", "count": 1 },

    // ---- stone tier ----
    { "input": ["cobblestone", "cobblestone", "cobblestone", "", "stick", "", "", "stick", ""], "output": "stone_pickaxe", "count": 1 },
    { "input": ["cobblestone", "cobblestone", "", "cobblestone", "stick", "", "", "stick", ""], "output": "stone_axe", "count": 1 },
    { "input": ["", "cobblestone", "", "", "stick", "", "", "stick", ""], "output": "stone_shovel", "count": 1 },

    // ---- iron tier ----
    { "input": ["iron", "iron", "iron", "", "stick", "", "", "stick", ""], "output": "iron_pickaxe", "count": 1 },
    { "input": ["iron", "iron", "", "iron", "stick", "", "", "stick", ""], "output": "iron_axe", "count": 1 },
    { "input": ["", "iron", "", "", "stick", "", "", "stick", ""], "output": "iron_shovel", "count": 1 },

    // ---- diamond tier ----
    { "input": ["diamond", "diamond", "diamond", "", "stick", "", "", "stick", ""], "output": "diamond_pickaxe", "count": 1 },
    { "input": ["diamond", "diamond", "", "diamond", "stick", "", "", "stick", ""], "output": "diamond_axe", "count": 1 },
    { "input": ["", "diamond", "", "", "stick", "", "", "stick", ""], "output": "diamond_shovel", "count": 1 },

    // ---- copper, gold, and quartz tool sets (all use existing block/item materials) ----
    { "input": ["copper", "copper", "copper", "", "stick", "", "", "stick", ""], "output": "copper_pickaxe", "count": 1 },
    { "input": ["copper", "copper", "", "copper", "stick", "", "", "stick", ""], "output": "copper_axe", "count": 1 },
    { "input": ["", "copper", "", "", "stick", "", "", "stick", ""], "output": "copper_shovel", "count": 1 },
    { "input": ["gold", "gold", "gold", "", "stick", "", "", "stick", ""], "output": "gold_pickaxe", "count": 1 },
    { "input": ["gold", "gold", "", "gold", "stick", "", "", "stick", ""], "output": "gold_axe", "count": 1 },
    { "input": ["", "gold", "", "", "stick", "", "", "stick", ""], "output": "gold_shovel", "count": 1 },
    { "input": ["quartz_shard", "quartz_shard", "quartz_shard", "", "stick", "", "", "stick", ""], "output": "quartz_pickaxe", "count": 1 },
    { "input": ["quartz_shard", "quartz_shard", "", "quartz_shard", "stick", "", "", "stick", ""], "output": "quartz_axe", "count": 1 },
    { "input": ["", "quartz_shard", "", "", "stick", "", "", "stick", ""], "output": "quartz_shovel", "count": 1 },
    { "input": ["bluestone", "bluestone", "bluestone", "", "stick", "", "", "stick", ""], "output": "bluestone_pickaxe", "count": 1 },
    { "input": ["bluestone", "bluestone", "", "bluestone", "stick", "", "", "stick", ""], "output": "bluestone_axe", "count": 1 },
    { "input": ["", "bluestone", "", "", "stick", "", "", "stick", ""], "output": "bluestone_shovel", "count": 1 },

    // 8 cobblestone ring -> kiln (Minecraft's furnace shape)
    { "input": ["cobblestone", "cobblestone", "cobblestone", "cobblestone", "", "cobblestone", "cobblestone", "cobblestone", "cobblestone"], "output": "kiln", "count": 1 },

    // coal or charcoal over a stick -> 4 torches
    { "input": ["coal", "", "stick", ""], "output": "torch", "count": 4 },
    { "input": ["charcoal", "", "stick", ""], "output": "torch", "count": 4 },

    // 6 planks in a 2x3 column -> 3 doors
    { "input": ["planks", "planks", "", "planks", "planks", "", "planks", "planks", ""], "output": "oak_door_bottom", "count": 3 }
  ],

  // ============================================================================
  // KILN / FURNACE: input -> output, seconds per item.
  // ============================================================================
  "smelting": [
    { "input": "coalore",     "output": "coal",     "time": 10 },
    { "input": "ironore",     "output": "iron",     "time": 10 },
    { "input": "goldore",     "output": "gold",     "time": 10 },
    { "input": "diamondore",  "output": "diamond",  "time": 10 },
    { "input": "copperore",   "output": "copper",   "time": 10 },
    { "input": "bluestoneore", "output": "bluestone", "time": 10 },
    { "input": "cobblestone", "output": "stone",    "time": 10 },
    { "input": "sand",        "output": "glass",    "time": 10 },
    { "input": "log",         "output": "charcoal", "time": 10 },
    { "input": "redclay",     "output": "bricks",   "time": 10 }
  ]
}
