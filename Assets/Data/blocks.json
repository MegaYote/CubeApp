{
  // ============================================================================
  // blocks.json — every block in the game. Hand-edited; comments (// and /* */)
  // and trailing commas are allowed anywhere.
  //
  // A block has a stable string "id" (used by code, biomes, drops...) AND a
  // numeric id = its POSITION in this list (0 = air, stored in world saves).
  // -> NEVER reorder or remove entries from the middle of the list.
  // -> New blocks go at the END. air must stay entry #0.
  //
  // FIELDS (all optional except "id" and "texture"/"base"):
  //   id              unique lowercase id, e.g. "stone"
  //   displayName     name shown in menus (defaults to id)
  //   texture         main atlas tile "col,row" from terrain.png (16x16 grid)
  //   top/bottom/side optional per-face tiles; omitted faces use "texture"
  //   itemTile        optional "col,row" from items.png used when this id
  //                   appears as a dropped/menu item (rare; see items.json)
  //   shape           "" (full cube) | "cross" (plant) | "cutout" (leaves) |
  //                   "glass" | "slab" | "slab_top" (top half) | "stairs"
  //   solid           collides with the player (default: true, false for cross)
  //   opaque          blocks skylight (default: true, false for see-through)
  //   transparent     hides faces between two of the same block (water|water)
  //   alpha           0..1 opacity tint for the tile (cross defaults 0.95)
  //   translucent     true = per-pixel alpha blending (colored glass)
  //   inventory       shows in the E menu (default true; _top halves default false)
  //   placeable       can be placed in the world (default true)
  //   gravity         falls when unsupported (sand, gravel, redclay)
  //   lightEmission   0..15 block light (torches = 14)
  //   mapColor        "#RRGGBB" minimap/swatch color (default #000000)
  //   hardness        seconds-ish mining time; 0 = built-in default by id family
  //                   (stone 4, dirt 0.5, wood 2, ore 3...); omit for sensible
  //   toolType        "pickaxe" | "axe" | "shovel" | "" (no tool preference)
  //   toolRequired    true = block only drops items when mined with the right tool
  //   zombieCanBreak  true = zombies can smash through it
  //   zombieBreakSpeed "Slow" | "Medium" | "Fast"
  //   base            inherit texture/top/bottom/side/mapColor from another
  //                   block id (great for slab/stairs variants of a material)
  //
  // SHAPE DEFAULTS (only applied when the field is OMITTED):
  //   cross   -> solid=false, opaque=false, transparent=true, alpha=0.95
  //   cutout  -> opaque=false, transparent=true
  //   glass   -> opaque=false, transparent=true
  //   slab/_top/stairs -> opaque=false;  _top also -> inventory=false
  //
  // EXAMPLES:
  //   // a plain new solid block:
  //   { "id": "myblock", "texture": "5,8" },
  //   // a new plant:
  //   { "id": "myflower", "texture": "6,8", "shape": "cross" },
  //   // a new glass pane / stairs for an existing material:
  //   { "id": "stone_pane", "base": "stone", "shape": "slab" },
  // ============================================================================

  "hotbar": [ "grass", "dirt", "stone", "cobblestone", "sand", "planks", "log", "leaves", "glass", "torch" ],

