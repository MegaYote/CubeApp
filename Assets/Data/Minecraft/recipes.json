{
  // Classic Survival frontier progression.
  // Station contract: "hand" is the 2x2 inventory grid; "carpenter" is the 3x3 carpenter's workbench.
  // All crafting and smelting entries name their station explicitly for RecipeRegistry gating.
  "recipes": [
    // ---- Hand: primitive tools and simple wood processing (2x2) ----
    { "input": ["log", "", "", ""], "output": "planks", "count": 4, "station": "hand" },
    { "input": ["planks", "", "planks", ""], "output": "stick", "count": 4, "station": "hand" },
    { "input": ["treated_planks", "treated_planks", "treated_planks", "treated_planks"], "output": "carpenters_workbench", "count": 1, "station": "hand" },

    // Sealant enables the existing planks -> treated_planks world interaction.
    { "input": ["planks", "planks", "sap", "sap"], "output": "bucket", "count": 1, "station": "hand" },
    { "input": ["sap", "water_bucket", "", ""], "output": "wood_sealant_bucket", "count": 1, "station": "hand" },

    // Flint primitives; sap binds the tool heads in the recipes that need it.
    { "input": ["flint", "stick", "", ""], "output": "flint_spear", "count": 1, "station": "hand" },
    { "input": ["stick", "flint", "stick", "sap"], "output": "flint_hatchet", "count": 1, "station": "hand" },
    { "input": ["flint", "flint", "stick", "sap"], "output": "flint_pickaxe", "count": 1, "station": "hand" },
    { "input": ["flint", "sap", "stick", ""], "output": "flint_shovel", "count": 1, "station": "hand" },

    // ---- Carpenter: stations, construction, transport and tools (3x3) ----
    // Eight cobblestone makes the first kiln.
    { "input": ["cobblestone", "cobblestone", "cobblestone", "cobblestone", "", "cobblestone", "cobblestone", "cobblestone", "cobblestone"], "output": "kiln", "count": 1, "station": "carpenter" },
    // A brick-and-stone forge, built after firing bricks in the kiln.
    { "input": ["bricks", "cobblestone", "bricks", "cobblestone", "log", "cobblestone", "bricks", "cobblestone", "bricks"], "output": "forge", "count": 1, "station": "carpenter" },

    // Construction recipes.
    { "input": ["planks", "planks", "", "planks", "planks", "", "planks", "planks", ""], "output": "oak_door_bottom", "count": 3, "station": "carpenter" },
    { "input": ["planks", "planks", "planks", "", "planks", "", "", "planks", ""], "output": "boat", "count": 1, "station": "carpenter" },
    { "input": ["stone", "stone", "stone", "", "", "", "", "", ""], "output": "stone_slab", "count": 6, "station": "carpenter" },
    { "input": ["cobblestone", "cobblestone", "cobblestone", "", "", "", "", "", ""], "output": "cobblestone_slab", "count": 6, "station": "carpenter" },
    { "input": ["planks", "planks", "planks", "", "", "", "", "", ""], "output": "planks_slab", "count": 6, "station": "carpenter" },
    { "input": ["sand", "sand", "sand", "", "", "", "", "", ""], "output": "sand_slab", "count": 6, "station": "carpenter" },
    { "input": ["dirt", "dirt", "dirt", "", "", "", "", "", ""], "output": "dirt_slab", "count": 6, "station": "carpenter" },
    { "input": ["bricks", "bricks", "bricks", "", "", "", "", "", ""], "output": "bricks_slab", "count": 6, "station": "carpenter" },
    { "input": ["stone", "stone", "stone", "stone", "", "", "", "", ""], "output": "stone_stairs", "count": 4, "station": "carpenter" },
    { "input": ["cobblestone", "cobblestone", "cobblestone", "cobblestone", "", "", "", "", ""], "output": "cobblestone_stairs", "count": 4, "station": "carpenter" },
    { "input": ["planks", "planks", "planks", "planks", "", "", "", "", ""], "output": "planks_stairs", "count": 4, "station": "carpenter" },
    { "input": ["sand", "sand", "sand", "sand", "", "", "", "", ""], "output": "sand_stairs", "count": 4, "station": "carpenter" },
    { "input": ["dirt", "dirt", "dirt", "dirt", "", "", "", "", ""], "output": "dirt_stairs", "count": 4, "station": "carpenter" },
    { "input": ["bricks", "bricks", "bricks", "bricks", "", "", "", "", ""], "output": "bricks_stairs", "count": 4, "station": "carpenter" },

    // Low-cost frontier transport: wood-based ore cart and rails.
    { "input": ["planks", "", "planks", "planks", "", "planks", "", "stick", ""], "output": "orecart", "count": 1, "station": "carpenter" },
    { "input": ["stick", "", "stick", "stick", "planks", "stick", "stick", "", "stick"], "output": "rail", "count": 16, "station": "carpenter" },

    // Copper tools and higher tiers remain carpenter-made and consume their existing material IDs.
    { "input": ["copper", "copper", "copper", "", "stick", "", "", "stick", ""], "output": "copper_pickaxe", "count": 1, "station": "carpenter" },
    { "input": ["copper", "copper", "", "copper", "stick", "", "", "stick", ""], "output": "copper_axe", "count": 1, "station": "carpenter" },
    { "input": ["", "copper", "", "", "stick", "", "", "stick", ""], "output": "copper_shovel", "count": 1, "station": "carpenter" },
    { "input": ["iron", "iron", "iron", "", "stick", "", "", "stick", ""], "output": "iron_pickaxe", "count": 1, "station": "carpenter" },
    { "input": ["iron", "iron", "", "iron", "stick", "", "", "stick", ""], "output": "iron_axe", "count": 1, "station": "carpenter" },
    { "input": ["", "iron", "", "", "stick", "", "", "stick", ""], "output": "iron_shovel", "count": 1, "station": "carpenter" },
    { "input": ["gold", "gold", "gold", "", "stick", "", "", "stick", ""], "output": "gold_pickaxe", "count": 1, "station": "carpenter" },
    { "input": ["gold", "gold", "", "gold", "stick", "", "", "stick", ""], "output": "gold_axe", "count": 1, "station": "carpenter" },
    { "input": ["", "gold", "", "", "stick", "", "", "stick", ""], "output": "gold_shovel", "count": 1, "station": "carpenter" },
    { "input": ["diamond", "diamond", "diamond", "", "stick", "", "", "stick", ""], "output": "diamond_pickaxe", "count": 1, "station": "carpenter" },
    { "input": ["diamond", "diamond", "", "diamond", "stick", "", "", "stick", ""], "output": "diamond_axe", "count": 1, "station": "carpenter" },
    { "input": ["", "diamond", "", "", "stick", "", "", "stick", ""], "output": "diamond_shovel", "count": 1, "station": "carpenter" },
    { "input": ["quartz_shard", "quartz_shard", "quartz_shard", "", "stick", "", "", "stick", ""], "output": "quartz_pickaxe", "count": 1, "station": "carpenter" },
    { "input": ["quartz_shard", "quartz_shard", "", "quartz_shard", "stick", "", "", "stick", ""], "output": "quartz_axe", "count": 1, "station": "carpenter" },
    { "input": ["", "quartz_shard", "", "", "stick", "", "", "stick", ""], "output": "quartz_shovel", "count": 1, "station": "carpenter" },
    { "input": ["bluestone", "bluestone", "bluestone", "", "stick", "", "", "stick", ""], "output": "bluestone_pickaxe", "count": 1, "station": "carpenter" },
    { "input": ["bluestone", "bluestone", "", "bluestone", "stick", "", "", "stick", ""], "output": "bluestone_axe", "count": 1, "station": "carpenter" },
    { "input": ["", "bluestone", "", "", "stick", "", "", "stick", ""], "output": "bluestone_shovel", "count": 1, "station": "carpenter" }
  ],

  // Kiln handles clay, charcoal and ceramics; forge handles all mined ore refinement.
  "smelting": [
    { "input": "raw_coal", "output": "coal", "time": 10, "station": "forge" },
    { "input": "raw_iron", "output": "iron", "time": 10, "station": "forge" },
    { "input": "raw_gold", "output": "gold", "time": 10, "station": "forge" },
    { "input": "raw_diamond", "output": "diamond", "time": 10, "station": "forge" },
    { "input": "raw_copper", "output": "copper", "time": 10, "station": "forge" },
    { "input": "raw_bluestone", "output": "bluestone", "time": 10, "station": "forge" },
    { "input": "redclay", "output": "bricks", "time": 10, "station": "kiln" },
    { "input": "log", "output": "charcoal", "time": 10, "station": "kiln" },
    { "input": "ceramic", "output": "bricks", "time": 10, "station": "kiln" },
    { "input": "sand", "output": "glass", "time": 10, "station": "kiln" },
    { "input": "cobblestone", "output": "stone", "time": 10, "station": "kiln" },
    { "input": "stone", "output": "smoothstone", "time": 10, "station": "kiln" },
    { "input": "mossycobblestone", "output": "cobblestone", "time": 10, "station": "kiln" },
    { "input": "sapling", "output": "charcoal", "time": 10, "station": "kiln" }
  ]
}